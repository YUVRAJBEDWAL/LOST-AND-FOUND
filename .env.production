# Production Environment Variables
DB_HOST=mysql
DB_PORT=3306
DB_NAME=campus_lost_found
DB_USER=campus_user
DB_PASSWORD=campus_password
DB_URL=jdbc:mysql://mysql:3306/campus_lost_found?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# JWT Configuration
JWT_SECRET=mySecretKey123456789012345678901234567890
JWT_EXPIRATION=86400000

# Server Configuration
SERVER_PORT=8080
FRONTEND_URL=http://localhost

# CORS Configuration
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_CAMPUS_LOSTFOUND=INFO
